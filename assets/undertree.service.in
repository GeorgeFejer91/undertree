[Unit]
Description=UnderTree offline editor service
After=graphical-session.target

[Service]
Type=simple
Environment=UNDERTREE_PORT=37371
Environment=UNDERTREE_LIBRARY_ROOT=%h/Documents/Overleaf-projects
Environment=UNDERTREE_TOKEN_FILE=%h/.config/undertree/token
ExecStart=@NODE_EXECUTABLE@ @APP_ROOT@/server.mjs
WorkingDirectory=@APP_ROOT@
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
