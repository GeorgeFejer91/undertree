{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local UnderTree editor can manage confined Typst and BibTeX files, compile bounded Typst source, save an explicitly requested PDF, reveal only its remembered export, and synchronize an explicitly linked project through UnderTree's Rust-owned GitHub connection.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-agent-annotations",
    "allow-bibliography-entries",
    "allow-choose-project",
    "allow-compile-document",
    "allow-compiler-info",
    "allow-create-bibliography",
    "allow-current-project",
    "allow-export-pdf",
    "allow-export-typst-to-latex",
    "allow-github-begin-auth",
    "allow-github-clone-repository",
    "allow-github-copy-device-code",
    "allow-github-create-repository",
    "allow-github-disconnect",
    "allow-github-link-project",
    "allow-github-list-repositories",
    "allow-github-open-auth-page",
    "allow-github-poll-auth",
    "allow-github-save-rules",
    "allow-github-set-editor-dirty",
    "allow-github-status",
    "allow-github-sync-project",
    "allow-github-unlink-project",
    "allow-import-latex-project",
    "allow-open-document",
    "allow-open-recent-project",
    "allow-recent-projects",
    "allow-refresh-project",
    "allow-remote-control-claim",
    "allow-remote-control-complete",
    "allow-remote-control-export-pdf",
    "allow-remote-control-open-project",
    "allow-remote-control-prepare-agent-replace",
    "allow-remote-control-ready",
    "allow-remote-control-reveal-pdf",
    "allow-reveal-exported-pdf",
    "allow-review-add-comment",
    "allow-review-create-proposal",
    "allow-review-decide",
    "allow-review-remove-mark",
    "allow-review-state",
    "allow-review-upsert-mark",
    "allow-save-document",
    "allow-set-agent-annotations",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
