    { "id": "neutral_cannot_bridge_edit_gap", "text": "Alpha 😀 beta gamma.", "marks": [{ "from": 0, "to": 6, "action": "prompt", "accessMode": "direct" }, { "from": 6, "to": 9, "action": "neutral", "accessMode": "suggestions" }, { "from": 9, "to": 13, "action": "prompt", "accessMode": "direct" }], "proposal": { "from": 0, "to": 13, "quote": "Alpha 😀 beta", "replacement": "changed" }, "result": "denied" },
