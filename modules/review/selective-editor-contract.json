    { "id": "missing_protected_identity_denied", "text": "One [A]. Two [B].", "marks": [{ "id": "paragraph", "from": 0, "to": 17, "action": "prompt", "accessMode": "direct" }, { "id": "citation-a", "from": 4, "to": 7, "action": "protect", "accessMode": "suggestions" }, { "id": "citation-b", "from": 13, "to": 16, "action": "protect", "accessMode": "suggestions" }], "proposal": { "from": 0, "to": 17, "quote": "One [A]. Two [B].", "replacement": "", "replacementParts": [{ "protectedId": "citation-a" }, { "text": " then [B]." }] }, "result": "denied" },
    { "id": "duplicate_protected_identity_denied", "text": "One [A]. Two [B].", "marks": [{ "id": "paragraph", "from": 0, "to": 17, "action": "prompt", "accessMode": "direct" }, { "id": "citation-a", "from": 4, "to": 7, "action": "protect", "accessMode": "suggestions" }, { "id": "citation-b", "from": 13, "to": 16, "action": "protect", "accessMode": "suggestions" }], "proposal": { "from": 0, "to": 17, "quote": "One [A]. Two [B].", "replacement": "", "replacementParts": [{ "protectedId": "citation-a" }, { "protectedId": "citation-a" }, { "protectedId": "citation-b" }] }, "result": "denied" },
    { "id": "continuous_group_cannot_be_retyped", "text": "One [A]. Two [B].", "marks": [{ "id": "paragraph", "from": 0, "to": 17, "action": "prompt", "accessMode": "direct" }, { "id": "citation-group", "from": 4, "to": 16, "action": "protect", "accessMode": "suggestions" }], "proposal": { "from": 0, "to": 17, "quote": "One [A]. Two [B].", "replacement": "", "replacementParts": [{ "text": "[B] then [A]." }] }, "result": "denied" },
