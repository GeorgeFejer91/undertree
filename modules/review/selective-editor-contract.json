    { "id": "identical_occurrences_keep_separate_identities", "text": "One [A]. Two [A].", "marks": [{ "id": "paragraph", "from": 0, "to": 17, "action": "prompt", "accessMode": "direct" }, { "id": "citation-first", "from": 4, "to": 7, "action": "protect", "accessMode": "suggestions" }, { "id": "citation-second", "from": 13, "to": 16, "action": "protect", "accessMode": "suggestions" }], "proposal": { "from": 0, "to": 17, "quote": "One [A]. Two [A].", "replacement": "", "replacementParts": [{ "protectedId": "citation-second" }, { "text": " then " }, { "protectedId": "citation-first" }, { "text": "." }] }, "result": "applied", "expectedText": "[A] then [A]." }
