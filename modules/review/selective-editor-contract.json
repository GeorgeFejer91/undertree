    { "id": "discard_requires_approval", "text": "Alpha 😀 beta gamma.", "marks": [{ "from": 9, "to": 13, "action": "discard", "accessMode": "suggestions" }], "proposal": { "from": 9, "to": 13, "quote": "beta", "replacement": "" }, "result": "pending" },
