<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="layout-document">
      <attribute name="version"><value>1</value></attribute>
      <optional><attribute name="title"><text/></attribute></optional>
      <optional><attribute name="lang"><text/></attribute></optional>
      <oneOrMore>
        <element name="page">
          <choice>
            <attribute name="size"><choice><value>A4</value><value>letter</value></choice></attribute>
            <group><attribute name="width"><text/></attribute><attribute name="height"><text/></attribute></group>
          </choice>
          <optional><attribute name="margin"><text/></attribute></optional>
          <optional><attribute name="background"><text/></attribute></optional>
          <element name="grid">
            <optional><attribute name="columns"><text/></attribute></optional>
            <optional><attribute name="rows"><text/></attribute></optional>
            <optional><attribute name="gap"><text/></attribute></optional>
            <oneOrMore>
              <element name="box">
                <optional><attribute name="id"><data type="ID"/></attribute></optional>
                <zeroOrMore><attribute><anyName/><text/></attribute></zeroOrMore>
                <zeroOrMore><ref name="block"/></zeroOrMore>
              </element>
            </oneOrMore>
          </element>
        </element>
      </oneOrMore>
    </element>
  </start>

  <define name="inline">
    <zeroOrMore>
      <choice>
        <text/>
        <element name="strong"><ref name="inline"/></element>
        <element name="em"><ref name="inline"/></element>
        <element name="code"><ref name="inline"/></element>
        <element name="link"><attribute name="href"><text/></attribute><ref name="inline"/></element>
        <element name="br"><empty/></element>
      </choice>
    </zeroOrMore>
  </define>

  <define name="block">
    <choice>
      <element name="heading"><ref name="inline"/></element>
      <element name="p"><ref name="inline"/></element>
      <element name="label"><ref name="inline"/></element>
      <element name="list"><oneOrMore><element name="item"><ref name="inline"/></element></oneOrMore></element>
      <element name="image">
        <attribute name="src"><text/></attribute>
        <zeroOrMore><attribute><anyName/><text/></attribute></zeroOrMore>
      </element>
      <element name="rule"><zeroOrMore><attribute><anyName/><text/></attribute></zeroOrMore></element>
      <element name="spacer"><zeroOrMore><attribute><anyName/><text/></attribute></zeroOrMore></element>
    </choice>
  </define>
</grammar>
