#!/usr/bin/env bash
set -euo pipefail

app_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/localtex-studio"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/localtex-studio"
token_file="$config_dir/token"
port=37371
profile_dir="$HOME/.var/app/com.brave.Browser/config/localtex-studio-profile"

mkdir -p "$config_dir" "$state_dir"
if [[ ! -s "$token_file" ]]; then
  umask 077
  node -e 'process.stdout.write(require("node:crypto").randomBytes(24).toString("hex"))' > "$token_file"
fi
token=$(<"$token_file")

if command -v systemctl >/dev/null && systemctl --user cat localtex-studio.service >/dev/null 2>&1; then
  systemctl --user start localtex-studio.service
elif ! curl --silent --fail "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then
  LOCALTEX_PORT="$port" LOCALTEX_TOKEN_FILE="$token_file" \
    node "$app_root/server.mjs" >>"$state_dir/server.log" 2>&1 &
fi

for _ in $(seq 1 80); do
  if curl --silent --fail "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done
curl --silent --fail "http://127.0.0.1:$port/api/health" >/dev/null

url="http://127.0.0.1:$port/?token=$token"
if [[ -n "${1:-}" ]]; then
  url="$url&project=$(printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]//g')"
fi

if flatpak info com.brave.Browser >/dev/null 2>&1; then
  exec flatpak run com.brave.Browser \
    --user-data-dir="$profile_dir" \
    --no-first-run \
    --no-default-browser-check \
    --disable-sync \
    --class=LocalTeXStudio \
    --app="$url"
elif command -v brave-browser >/dev/null; then
  exec brave-browser --user-data-dir="$profile_dir" --class=LocalTeXStudio --app="$url"
elif command -v chromium >/dev/null; then
  exec chromium --user-data-dir="$profile_dir" --class=LocalTeXStudio --app="$url"
else
  echo "LocalTeX Studio needs Brave or Chromium to display its offline interface." >&2
  exit 1
fi
