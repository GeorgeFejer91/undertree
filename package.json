{
  "name": "undertree",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "UnderTree, an offline Rust/Tauri manuscript workspace with HTML/CSS and Typst",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgeFejer91/undertree.git"
  },
  "bin": {
    "undertree": "cli.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "layout:example": "node layout/compiler.mjs examples/adaptive-boxes.layout.xml",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:architecture": "node modules/maintenance/validate-architecture.mjs",
    "generate:notices": "node modules/maintenance/generate-notices.mjs",
    "verify:notices": "node modules/maintenance/generate-notices.mjs --check",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:pdf-controls": "node tests/pdf-controls-smoke.mjs",
    "render:pdf-preview": "npm run build && node scripts/render-pdf-preview.mjs",
    "stress:pdf-ui": "npm run render:pdf-preview",
    "dev:review": "vite --host 127.0.0.1",
    "desktop": "npm run build && cargo run -p undertree-desktop --features custom-protocol",
    "test:review": "node --test tests/review-session.test.mjs tests/review-position.test.mjs tests/source-format.test.mjs && cargo test -p undertree-review",
    "test:review-ui": "node tests/review-ui-smoke.mjs",
    "test:review-selection": "node tests/review-selection-smoke.mjs",
    "test:review-policy": "node tests/review-policy-smoke.mjs",
    "test:word-count": "node tests/word-count-smoke.mjs",
    "test:html-editor": "node tests/html-editor-smoke.mjs",
    "test:review-buffers": "node tests/review-buffer-limit-smoke.mjs",
    "test:typst-authoring": "node tests/typst-authoring-smoke.mjs",
    "test:typst-publishing": "node tests/typst-publishing-smoke.mjs",
    "test:connections-ui": "node tests/connections-ui-smoke.mjs",
    "connection:profile": "node modules/maintenance/secret-tunnel-profile.mjs",
    "test:native-ui": "node tests/native-ui-smoke.mjs",
    "test:native-word-count": "node tests/native-word-count-smoke.mjs",
    "test:native-publishing": "node tests/native-publishing-smoke.mjs",
    "test:native-import": "node tests/native-import-smoke.mjs",
    "test:native-project-export": "node tests/native-project-export-smoke.mjs",
    "test:native-project-export-epoch": "node tests/native-project-export-epoch-smoke.mjs",
    "test:live-github": "node tests/live-github-sync.mjs",
    "test:review-text-layout": "node tests/review-text-layout-smoke.mjs",
    "build:native": "npm run build && cargo build -p undertree-desktop --release --features custom-protocol",
    "build:installer:linux": "bash scripts/build-native-release.sh",
    "test:installer:linux": "node modules/maintenance/verify-native-package.mjs",
    "test:editor-save": "node tests/editor-save-smoke.mjs",
    "test:workspace-layout": "node tests/workspace-layout-smoke.mjs",
    "test:editor-settings": "node tests/editor-settings-smoke.mjs",
    "test:project-tree": "node tests/project-tree-smoke.mjs",
    "test:pdf-export-consent": "node tests/pdf-export-consent-smoke.mjs",
    "test:pdf-export": "node tests/pdf-export-smoke.mjs",
    "test:mcp-app-controls": "node tests/mcp-app-controls-smoke.mjs",
    "test:mcp-review-policy": "node tests/mcp-review-policy-smoke.mjs",
    "test:review-discard": "node tests/review-discard-smoke.mjs",
    "test:mcp-hub": "node tests/mcp-hub-smoke.mjs",
    "test:mcp-hub-ui": "node tests/mcp-hub-ui-smoke.mjs",
    "test:native-mcp-hub": "node tests/native-mcp-hub-smoke.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@openai/codex-sdk": "0.147.0",
    "@tauri-apps/api": "2.12.4",
    "codemirror": "^6.0.2",
    "fast-xml-parser": "^5.10.1",
    "parse5": "^8.0.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.1"
  }
}
