{
  "name": "localtex-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline Overleaf-style desktop workspace for local TeX projects",
  "scripts": {
    "build": "vite build",
    "layout:example": "node layout/compiler.mjs examples/adaptive-boxes.layout.xml",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:pdf-controls": "node tests/pdf-controls-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "codemirror": "^6.0.2",
    "fast-xml-parser": "^5.10.1",
    "pdfjs-dist": "5.6.205"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "vite": "^7.1.1"
  }
}
