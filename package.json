{
  "name": "undertree",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "UnderTree, an offline Overleaf-style desktop workspace for local TeX projects",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgeFejer91/undertree_texstudio.git"
  },
  "main": "native/windows/main.cjs",
  "bin": { "undertree": "cli.mjs" },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "build:windows": "npm run build && electron-builder --win nsis",
    "layout:example": "node layout/compiler.mjs examples/adaptive-boxes.layout.xml",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:architecture": "node modules/maintenance/validate-architecture.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:pdf-controls": "node tests/pdf-controls-smoke.mjs",
    "render:pdf-preview": "npm run build && node scripts/render-pdf-preview.mjs",
    "stress:pdf-ui": "npm run render:pdf-preview"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@openai/codex-sdk": "0.147.0",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-color": "^3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/extension-text-style": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "codemirror": "^6.0.2",
    "fast-xml-parser": "^5.10.1",
    "parse5": "^8.0.1",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "io.github.georgefejer91.UnderTree",
    "productName": "UnderTree",
    "artifactName": "UnderTree-${version}-Windows-${arch}.${ext}",
    "directories": { "output": "release/windows" },
    "files": [
      "dist/**/*", "layout/**/*", "src/**/*.js", "src/**/*.mjs",
      "native/windows/**/*", "native/html_print_renderer.py", "server.mjs", "modules/compiler/**/*.mjs",
      "cli.mjs", "package.json", "node_modules/**/*",
      "!node_modules/@codemirror/**/*", "!node_modules/@napi-rs/**/*",
      "!node_modules/@openai/**/*", "!node_modules/@tiptap/**/*",
      "!node_modules/codemirror/**/*", "!node_modules/pdfjs-dist/**/*"
    ],
    "extraFiles": [
      { "from": "native/windows/undertree.cmd", "to": "undertree.cmd" }
    ],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "native/windows/installer.nsh"
    }
  }
}
